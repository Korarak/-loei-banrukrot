# ===========================================
# Backend Environment Variables
# Copy this file to .env and fill in the values
# ===========================================

# MongoDB Connection
MONGODB_URI=mongodb://username:password@host:port/database?authSource=admin

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# Server Port
PORT=8080

# PromptPay (Payment) — fallback only, used if no owner has set it yet in admin Settings > PromptPay
PROMPTPAY_ID=your_promptpay_id

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# Web Push (chat notifications) — generate once with `npx web-push generate-vapid-keys`.
# The private key is a one-way door: losing/rotating it invalidates every existing
# browser subscription. NEXT_PUBLIC_VAPID_PUBLIC_KEY in frontend/.env.local must be
# set to the same public key value.
WEB_PUSH_VAPID_PUBLIC_KEY=your_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=your_vapid_private_key
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com

# SMTP — ใช้สำหรับ "ลืมรหัสผ่าน" และยืนยันอีเมล
# ไม่ตั้งค่าก็รันได้ปกติ แค่สองฟีเจอร์นั้นจะไม่ทำงาน (utils/mailer.js จะ skip แล้ว log เตือน)
# ใช้ SMTP มาตรฐาน จึงชี้ไปเจ้าไหนก็ได้ ที่มี free tier ตอนนี้:
#   Brevo   — smtp-relay.brevo.com:587       ฟรี 300 ฉบับ/วัน
#   Resend  — smtp.resend.com:587            ฟรี 3,000 ฉบับ/เดือน (SMTP_USER=resend)
# สำคัญ: ต้อง verify domain แล้วตั้ง SPF + DKIM ใน DNS ไม่งั้นอีเมลจะเข้า Spam ของ Gmail
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# ต้องเป็นอีเมลบนโดเมนที่ verify แล้ว
SMTP_FROM="บ้านรักรถเมืองเลย <noreply@banrukrot.com>"
